model ImportErrorLog {
  id         BigInt           @id @default(autoincrement())
  jobId      Int
  rowNumber  Int
  entityType ImportEntityType
  sourceOid  Int?
  sourceCode String?
  itemId     Int?
  field      String?
  message    String
  rawLine    String?
  action     ImportRowAction  @default(REJETE)
  createdAt  DateTime         @default(now())

  job  ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  item Item?     @relation(fields: [itemId], references: [id])

  @@index([jobId])
  @@index([entityType])
}

/// Correspondance configurable entre un code present dans les donnees sources
/// et la valeur utilisee par la plateforme. Aucune correspondance n'est devinee
/// silencieusement : tant qu'une valeur n'est pas confirmee par l'administrateur,
/// la donnee source est conservee telle quelle et signalee comme a confirmer.
model ImportValueMapping {
  id           Int      @id @default(autoincrement())
  sourceEntity String
  sourceField  String
  sourceValue  String
  targetValue  String
  label        String?
  isConfirmed  Boolean  @default(false)
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sourceEntity, sourceField, sourceValue])
  @@index([sourceEntity, sourceField])
}

/// Copie brute d'une ligne source importee.
/// Elle permet de retrouver la valeur d'origine en cas de contradiction,
/// et sert de reference temporelle pour detecter qu'une fiche a ete modifiee
/// dans la plateforme apres l'import : une nouvelle importation ne doit jamais
/// ecraser silencieusement une saisie locale.
model ImportRowSnapshot {
  id           BigInt   @id @default(autoincrement())
  sourceSystem String
  sourceEntity String
  sourceOid    Int
  sourceSyncId String?
  fileName     String
  jobId        Int?
  payload      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sourceSystem, sourceEntity, sourceOid])
  @@index([sourceEntity])
  @@index([jobId])
}

// =============================================================================
// 17. MES AVANCE
//     Sous-stocks par operation, postes a QR permanent, programmes de travail.
//
//     Principe : les sous-stocks ne sont PAS un second moteur de stock. Ce sont
//     des emplacements (Location) des depots d'en-cours, auxquels on donne une
//     identite metier. Les quantites officielles restent dans StockBalance et
//     tout mouvement reste dans le grand livre StockMovement.
// =============================================================================

/// Nature d'un sous-stock operationnel.
enum SubStockKind {
  ENTREE_OPERATION
  SORTIE_OPERATION
  TAMPON
  ATTENTE_QUALITE
}

/// Resultat d'un scan de poste de travail.
enum ScanResult {
  ACCEPTE
  REFUSE
}

/// Etat d'un programme de travail, journalier ou hebdomadaire.
enum ScheduleStatus {
  BROUILLON
  PUBLIE
  ARCHIVE
}

/// Sous-stock d'une operation : l'emplacement ou la production conforme se
/// depose avant le passage a l'etape suivante.
///
/// Aucune quantite n'est stockee ici. La quantite vit dans StockBalance, indexee
/// sur `locationId`. Ce modele porte l'identite metier : quelle operation, quel
/// atelier, quel poste, et a quelle etape de la gamme.
model OperationSubStock {
  id            Int          @id @default(autoincrement())
  code          String       @unique
  label         String
  operationId   Int
  factory       Factory      @default(ADMEDCO)
  workshopId    Int?
  workCenterId  Int?
  warehouseId   Int
  locationId    Int
  kind          SubStockKind @default(SORTIE_OPERATION)
  sequenceOrder Int          @default(0)
  isActive      Boolean      @default(true)
  description   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  operation  Operation   @relation(fields: [operationId], references: [id])
  workshop   Workshop?   @relation(fields: [workshopId], references: [id])
  workCenter WorkCenter? @relation(fields: [workCenterId], references: [id])
  warehouse  Warehouse   @relation(fields: [warehouseId], references: [id])
  location   Location    @relation(fields: [locationId], references: [id])

  outgoingLinks OperationSubStockLink[] @relation("SubStockLinkFrom")
  incomingLinks OperationSubStockLink[] @relation("SubStockLinkTo")
  transfersOut  OperationStepTransfer[] @relation("StepTransferFrom")
  transfersIn   OperationStepTransfer[] @relation("StepTransferTo")
  declarations  OperationDeclaration[]

  @@unique([operationId, warehouseId])
  @@index([factory])
  @@index([sequenceOrder])
}

/// Dependance entre deux sous-stocks.
///
/// C'est ce qui permet les branches paralleles : la couture et la preparation
/// du bois alimentent toutes deux l'assemblage final, sans etre forcees dans une
/// chaine unique. L'assemblage attend que toutes ses branches requises aient la
/// quantite necessaire.
model OperationSubStockLink {
  id             Int      @id @default(autoincrement())
  fromSubStockId Int
  toSubStockId   Int
  isRequired     Boolean  @default(true)
  quantityRatio  Decimal  @default(1) @db.Decimal(18, 6)
  note           String?
  createdAt      DateTime @default(now())

  fromSubStock OperationSubStock @relation("SubStockLinkFrom", fields: [fromSubStockId], references: [id], onDelete: Cascade)
  toSubStock   OperationSubStock @relation("SubStockLinkTo", fields: [toSubStockId], references: [id], onDelete: Cascade)

  @@unique([fromSubStockId, toSubStockId])
  @@index([toSubStockId])
}

/// Passage trace d'une quantite conforme d'un sous-stock vers l'etape suivante.
///
/// `transferKey` est deterministe : elle combine l'operation de l'OF, les deux
/// sous-stocks, l'article et le lot. Un meme passage ne peut donc jamais etre
/// enregistre deux fois — ni par un double clic, ni par un rejeu de requete, ni
/// par une seconde validation. La contrainte d'unicite fait le travail, la
/// transaction garantit que les deux mouvements vont ensemble ou pas du tout.
model OperationStepTransfer {
  id                   BigInt @id @default(autoincrement())
  transferKey          String @unique
  workOrderId          Int
  workOrderOperationId Int
  operationId          Int
  fromSubStockId       Int
  toSubStockId         Int
  itemId               Int
  lotId                Int?

  quantity Decimal @default(0) @db.Decimal(18, 6)
  unitCode String?

  /// Les deux ecritures du grand livre engendrees par le passage. Renseignees
  /// dans la meme transaction que le transfert lui-meme.
  outMovementId BigInt?
  inMovementId  BigInt?

  declarationId BigInt?
  validatedById Int?
  validatedAt   DateTime?
  occurredAt    DateTime  @default(now())
  comment       String?
  createdAt     DateTime  @default(now())

  workOrder          WorkOrder             @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderOperation WorkOrderOperation    @relation(fields: [workOrderOperationId], references: [id], onDelete: Cascade)
  operation          Operation             @relation(fields: [operationId], references: [id])
  fromSubStock       OperationSubStock     @relation("StepTransferFrom", fields: [fromSubStockId], references: [id])
  toSubStock         OperationSubStock     @relation("StepTransferTo", fields: [toSubStockId], references: [id])
  item               Item                  @relation(fields: [itemId], references: [id])
  lot                StockLot?             @relation(fields: [lotId], references: [id])
  declaration        OperationDeclaration? @relation(fields: [declarationId], references: [id])
  validatedBy        Employee?             @relation("StepTransferValidatedBy", fields: [validatedById], references: [id])

  @@index([workOrderId])
  @@index([workOrderOperationId])
  @@index([occurredAt])
}

/// Trace d'un scan de QR de poste. Conserve meme les refus : un scan refuse est
/// une information, pas un evenement a jeter.
model WorkCenterScan {
  id           BigInt     @id @default(autoincrement())
  workCenterId Int
  employeeId   Int?
  userId       Int?
  factory      Factory
  result       ScanResult
  reason       String?
  userAgent    String?
  scannedAt    DateTime   @default(now())

  workCenter WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)
  employee   Employee?  @relation(fields: [employeeId], references: [id])

  @@index([workCenterId, scannedAt])
  @@index([employeeId, scannedAt])
}

/// Programme de travail d'un atelier, sur un jour ou une semaine.
///
/// Le programme publie est la reference : le modifier ne reecrit pas
/// l'historique, il cree une revision (`replacesId`).
model WorkSchedule {
  id            Int            @id @default(autoincrement())
  code          String         @unique
  label         String
  factory       Factory
  workshopId    Int?
  periodStart   DateTime       @db.Date
  periodEnd     DateTime       @db.Date
  status        ScheduleStatus @default(BROUILLON)
  responsibleId Int?
  publishedById Int?
  publishedAt   DateTime?
  note          String?
  replacesId    Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workshop    Workshop?      @relation(fields: [workshopId], references: [id])
  responsible Employee?      @relation("ScheduleResponsible", fields: [responsibleId], references: [id])
  publishedBy Employee?      @relation("SchedulePublishedBy", fields: [publishedById], references: [id])
  replaces    WorkSchedule?  @relation("ScheduleRevision", fields: [replacesId], references: [id])
  replacedBy  WorkSchedule[] @relation("ScheduleRevision")

  assignments Assignment[]

  @@index([factory, periodStart])
  @@index([status])
  @@index([workshopId, periodStart])
}

/// Historique des modifications d'une affectation.
///
/// Toute reaffectation en cours de journee laisse une trace : qui, quand,
/// pourquoi, et ce qui a change. L'historique n'est jamais reecrit.
model AssignmentChange {
  id                   Int       @id @default(autoincrement())
  assignmentId         Int
  changeType           String
  previousEmployeeId   Int?
  newEmployeeId        Int?
  previousWorkCenterId Int?
  newWorkCenterId      Int?
  previousPriority     Priority?
  newPriority          Priority?
  previousSequence     Int?
  newSequence          Int?
  reason               String?
  /// Auteur du changement. `changedById` porte l'employe quand le geste vient
  /// d'une fiche RH ; `changedByUserId` porte le compte connecte dans tous les
  /// cas, y compris quand l'auteur n'est pas un employe (planificateur,
  /// responsable d'atelier).
  changedById          Int?
  changedByUserId      Int?
  changedAt            DateTime  @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  changedBy  Employee?  @relation("AssignmentChangeAuthor", fields: [changedById], references: [id])

  @@index([assignmentId])
  @@index([changedAt])
}
