# Copie ces valeurs dans le fichier .env du serveur, puis ne versionne jamais
# ce fichier. Ne place aucun mot de passe dans GitHub.
NODE_ENV=production
APP_URL=https://erp.admedco.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SESSION_TTL_HOURS=12
CSV_SOURCE_DIR=/var/lib/erpmes/imports
# Les options d'acces rapide doivent rester desactivees en production.
AUTH_ACCES_RAPIDE=false
AUTH_ACCES_RAPIDE_COMPTES=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NOM=
BOOTSTRAP_ADMIN_PRENOM=
BOOTSTRAP_ADMIN_PASSWORD=
