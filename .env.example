# =============================================================================
# ERPMES ADMEDCO / MOBILIX - Modele de configuration
# Copier ce fichier vers .env puis renseigner les valeurs reelles.
# =============================================================================

DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/erpmes?schema=public"

# Chaine aleatoire longue (>= 48 caracteres). Generer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

SESSION_TTL_HOURS="12"

CSV_SOURCE_DIR="E:/Massiexporte"

# Adresse publique de la plateforme, telle qu'elle doit apparaitre dans les QR
# codes de poste imprimes. Laisser vide pour reprendre l'hote reel de la requete.
APP_URL=""

# Renseigner uniquement pour la commande `npm run bootstrap:admin`.
# Ces valeurs ne sont jamais utilisees au demarrage de l'application.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_PRENOM=""
BOOTSTRAP_ADMIN_NOM=""

# -----------------------------------------------------------------------------
# Acces rapide de developpement (page /connexion uniquement).
# A NE JAMAIS ACTIVER EN PRODUCTION : le bloc est de toute facon ignore des que
# NODE_ENV vaut "production". Format d'une entree : libelle | adresse | mot de passe
# plusieurs entrees separees par « ; ». Aucun mot de passe n'est ecrit dans le code.
# -----------------------------------------------------------------------------
AUTH_ACCES_RAPIDE="false"
AUTH_ACCES_RAPIDE_COMPTES=""

NODE_ENV="production"
